# Copy to .env on the deploy host. Generate secrets with: openssl rand -base64 32
APP_PORT=3060
BETTER_AUTH_URL=http://your-server:3060
# Extra origins that may sign in (e.g. reverse proxy), comma-separated
TRUSTED_ORIGINS=https://lovedays.example.com:3060
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
# scripts/deploy.sh builds .next/standalone in a resource-capped container, then uses the runtime-only image
APP_DOCKERFILE=Dockerfile.runtime
# Optional: faster npm mirror for builds
NPM_REGISTRY=https://registry.npmmirror.com/
